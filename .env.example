DB_USER=db_user
DB_PASSWORD=db_password
DB_NAME=db_name
DB_HOST=db_host
DB_PORT=db_port
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_long_unique_password
# ADMIN_PASSWORD также используется командой /admin в Telegram-боте.
# Для веб-админки дополнительно можно указать werkzeug-хеш этого пароля.
ADMIN_PASSWORD_HASH=
ADMIN_URL_SECRET=replace_with_at_least_32_random_letters_digits_or_hyphens
# Полная внешняя ссылка, которую Telegram-бот пришлёт после /admin_on.
ADMIN_PUBLIC_URL=http://IP_СЕРВЕРА:5555/replace_with_at_least_32_random_letters_digits_or_hyphens/admin/
BOT_TOKEN=bot_token
ADMIN_ID=admin_id
SEMESTER_IS_ODD=true
SECRET_KEY=replace_with_at_least_32_random_characters
ADMIN_BIND_ADDRESS=0.0.0.0
ADMIN_COOKIE_SECURE=false
DB_URL=db_url
SCHEDULE_MONITOR_TIMEZONE=Europe/Moscow
SCHEDULE_MONITOR_HOUR=9
SCHEDULE_MONITOR_MINUTE=0
SCHEDULE_MONITOR_CONCURRENCY=3
SCHEDULE_MONITOR_TIMEOUT=20
SCHEDULE_MONITOR_ATTEMPTS=5
SCHEDULE_MONITOR_INCLUDE_ASPIRANTS=false
SCHEDULE_MONITOR_RUN_ON_START=false
